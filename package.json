{
  "name": "dsh-humanize",
  "version": "0.1.0",
  "description": "让推理模型专注干活，让交付内容好好说人话。写入标记、PROSE 规则集、旁路审查、延迟润色。",
  "type": "module",
  "main": "lib/index.js",
  "types": "types.d.ts",
  "scripts": {
    "test": "node --test",
    "stamp:client": "node scripts/stamp-client.mjs"
  },
  "exports": {
    ".": {
      "types": "./types.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./client/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-sidebar-documentpreview"
      ],
      "platform": "web"
    }
  },
  "files": [
    "LICENSE",
    "lib",
    "client",
    "prompts",
    "types.d.ts",
    "icon.svg",
    "locale/*.json",
    "cordis.patch.yml",
    ".agents/prose/base.md",
    ".agents/prose/docs.md",
    ".agents/prose/source.md",
    "README.md",
    "README.zh.md",
    "DESIGN.md"
  ],
  "dependencies": {
    "diff": "^9.0.0",
    "isbinaryfile": "^5.0.7"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/cosmokit": "^1.8.5",
    "@deepseek-ai/dsh-agent-preset": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-atomic-write": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-home-paths": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-jobs": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-llm": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-persona": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-scope": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-session-query": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-timeout": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-tool-fs": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-tool-fs-search": "^0.2.1-rc.2",
    "@deepseek-ai/schemastery": "^3.18.1",
    "js-yaml": "^4.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lry722/dsh-humanize.git"
  },
  "homepage": "https://github.com/Lry722/dsh-humanize#readme",
  "bugs": {
    "url": "https://github.com/Lry722/dsh-humanize/issues"
  },
  "author": "Lry722 <958515687@qq.com>",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "prose",
    "writing",
    "review",
    "annotations"
  ],
  "engines": {
    "node": ">=20.3"
  },
  "license": "MIT",
  "icon": "./icon.svg"
}
