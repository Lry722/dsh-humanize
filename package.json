{
  "name": "dsh-humanize",
  "version": "0.1.0",
  "description": "让推理模型专注干活，让交付内容好好说人话。写入标记、PROSE.md 分层规范、旁路审查、延迟合并。",
  "type": "module",
  "main": "lib/index.js",
  "types": "types.d.ts",
  "scripts": {
    "test": "node --test",
    "stamp:client": "node scripts/stamp-client.mjs"
  },
  "exports": {
    ".": {
      "types": "./types.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./client/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ],
      "platform": "web"
    }
  },
  "files": [
    "lib",
    "client",
    "prompts",
    "types.d.ts",
    "icon.svg",
    "locale/*.json",
    "cordis.patch.yml",
    "PROSE.md",
    "README.md",
    "DESIGN.md"
  ],
  "dependencies": {
    "diff": "^9.0.0",
    "isbinaryfile": "^5.0.7"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/cosmokit": "^1.8.5",
    "@deepseek-ai/dsh-atomic-write": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-home-paths": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-jobs": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-llm": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-scope": "^0.2.1-rc.2",
    "@deepseek-ai/schemastery": "^3.18.1",
    "js-yaml": "^4.1.0"
  },
  "license": "MIT",
  "icon": "./icon.svg"
}
